\\n*** End Patch\"}},\"jsonrpc\":\"2.0\",\"id\":1}","headers":{"host":"err-stealth-16-ai-studio-a1vgg.tailbe888a.ts.net","user-agent":"openai-mcp/1.0.0","content-length":"1713","accept":"application/json, text/event-stream","accept-encoding":"gzip, deflate, br, zstd","authorization":"[REDACTED]","content-type":"application/json","mcp-protocol-version":"2025-06-18","mcp-session-id":"d775c276-0a4d-4e16-a39a-a8bb2d5de665","tailscale-funnel-request":"?1","traceparent":"00-698a51cb000000006894e23830b0ae2c-86a19a33bf25b7d3-00","tracestate":"dd=s:-1;p:67b3e9de283ce542;t.dm:-3","x-datadog-parent-id":"14995324344160823311","x-datadog-sampling-priority":"-1","x-datadog-tags":"_dd.p.tid=698a51cb00000000,_dd.p.dm=-3","x-datadog-trace-id":"7535896807460613676","x-forwarded-for":"172.212.159.71","x-forwarded-host":"err-stealth-16-ai-studio-a1vgg.tailbe888a.ts.net","x-forwarded-proto":"https","x-openai-session":"v1/3oN9WGweOW5Rpu1bhuASBPvzqxgaKPmpJmiaG4Xson2PQImsZbUlzqsZLQyKtm2XiuDc2gk3CWFv","x-openai-subject":"v1/EoL8uJNwuHvN3hSuCC9BvtYvBPjCdVdLp6PTYPGDOQt8z4LENEQfcU"},"msg":"proxying to MCP"}
