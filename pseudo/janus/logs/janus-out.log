t: number;\\n+  text: string;\\n+  approxTokens?: number;\\n+  paths?: string[];\\n+}): EventEnvelopeV1 {\\n+  const {\\n+    sessionId,\\n+    sessionTitle,\\n+    chunkIndex,\\n+    messageIdStart,\\n+    messageIdEnd,\\n+    messageIndexStart,\\n+    messageIndexEnd,\\n+    createdAt,\\n+    text,\\n+    approxTokens,\\n+    paths,\\n+  } = params;\\n+\\n+  const id = sha256(`${sessionId}:chunk:${chunkIndex}:${messageIdStart}:${messageIdEnd}`);\\n+  const ts = new Date(createdAt).toISOString();\\n+\\n+  const meta: Record<string, unknown> = {\\n+    role: \\\"mixed\\\",\\n+    session_title: sessionTitle,\\n+    chunk_index: chunkIndex,\\n+    message_id_start: messageIdStart,\\n+    message_id_end: messageIdEnd,\\n+    message_index_start: messageIndexStart,\\n+    message_index_end: messageIndexEnd,\\n+    approx_tokens: typeof approxTokens === \\\"number\\\" ? approxTokens : undefined,\\n+  };\\n+\\n+  if (paths && paths.length > 0) {\\n+    meta.paths = paths.join(\\\"|\\\");\\n+  }\\n+\\n+  return {\\n+    schema: \\\"openplanner.event.v1\\\",\\n+    id,\\n+    ts,\\n+    source: \\\"opencode-sessions\\\",\\n+    kind: \\\"chunk\\\",\\n+    source_ref: {\\n+      session: sessionId,\\n+      message: `${messageIdStart}..${messageIdEnd}`,\\n+    },\\n+    text,\\n+    meta,\\n+  };\\n+}\\n*** End Patch\"}},\"jsonrpc\":\"2.0\",\"id\":1}","headers":{"host":"err-stealth-16-ai-studio-a1vgg.tailbe888a.ts.net","user-agent":"openai-mcp/1.0.0","content-length":"2941","accept":"application/json, text/event-stream","accept-encoding":"gzip, deflate, br, zstd","authorization":"[REDACTED]","content-type":"application/json","mcp-protocol-version":"2025-06-18","mcp-session-id":"24b74027-8d36-4526-a308-fad2fa097873","tailscale-funnel-request":"?1","traceparent":"00-698badfe000000002a5ed23c0e16c707-ee26e109e99e6419-00","tracestate":"dd=s:-1;p:5d88244bf055141a;t.dm:-3","x-datadog-parent-id":"14280932936882103277","x-datadog-sampling-priority":"-1","x-datadog-tags":"_dd.p.tid=6