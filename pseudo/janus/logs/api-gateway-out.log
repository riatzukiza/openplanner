ed.\\n\\n\",\"message\":\"Add MCP migration spec docs\",\"backend\":\"local\"}},\"jsonrpc\":\"2.0\",\"id\":1}","headers":{"host":"err-stealth-16-ai-studio-a1vgg.tailbe888a.ts.net","user-agent":"openai-mcp/1.0.0","content-length":"1770","accept":"application/json, text/event-stream","accept-encoding":"gzip, deflate, br, zstd","authorization":"[REDACTED]","content-type":"application/json","mcp-protocol-version":"2025-06-18","mcp-session-id":"8ac32426-4ccb-4181-8b44-1d0f1963686a","tailscale-funnel-request":"?1","traceparent":"00-698836db00000000e39dacbe6e0e649b-477dcb4cd242b11e-00","tracestate":"dd=s:-1;p:41551c77145d807d;t.dm:-3","x-datadog-parent-id":"13355084719125587486","x-datadog-sampling-priority":"-1","x-datadog-tags":"_dd.p.tid=698836db00000000,_dd.p.dm=-3","x-datadog-trace-id":"16401455351843415195","x-forwarded-for":"172.212.159.70","x-forwarded-host":"err-stealth-16-ai-studio-a1vgg.tailbe888a.ts.net","x-forwarded-proto":"https","x-openai-session":"v1/4umQx92rHGfOMES3pj5NnXGLqlPi4PynMVMDrOBbKTdddlv9jzwUl6pyRLF9MsG5PjcnEvL9bmWI","x-openai-subject":"v1/EoL8uJNwuHvN3hSuCC9BvtYvBPjCdVdLp6PTYPGDOQt8z4LENEQfcU"},"msg":"proxying to MCP"}
